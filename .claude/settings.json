{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git worktree *)",
      "Bash(git mv *)",
      "Bash(git ls-files *)",
      "Bash(git remote -v)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(uv run *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npm run build *)",
      "Bash(npm ls *)",
      "Bash(sqlite3 *)",
      "Bash(palace issue*)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Bash(git push)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * *:main*)",
      "Bash(git push * +main*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(scripts/deploy-to-pi.sh*)",
      "Bash(./scripts/deploy-to-pi.sh*)",
      "Bash(bash scripts/deploy-to-pi.sh*)",
      "Bash(bash ./scripts/deploy-to-pi.sh*)"
    ]
  }
}
