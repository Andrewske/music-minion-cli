{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git worktree *)",
      "Bash(git mv *)",
      "Bash(git ls-files *)",
      "Bash(git push *)",
      "Bash(git remote -v)",
      "Bash(uv run *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npm run build *)",
      "Bash(npm ls *)",
      "Bash(sqlite3 *)",
      "Bash(palace issue*)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Bash(scripts/deploy-to-pi.sh*)",
      "Bash(./scripts/deploy-to-pi.sh*)",
      "Bash(bash scripts/deploy-to-pi.sh*)",
      "Bash(bash ./scripts/deploy-to-pi.sh*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=~/.claude/hooks/bash-guard.py; [ ! -f \"$f\" ] || exec python3 -I \"$f\""
          }
        ]
      }
    ]
  }
}
